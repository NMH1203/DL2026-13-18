# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env

# Build and package outputs
build/
dist/
*.egg-info/
.eggs/
wheels/

# Virtual environments and local secrets
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Jupyter temporary files
.ipynb_checkpoints/

# Personal helper notebooks (local only)
Notebooks/NMH/github_pull.ipynb

# Dataset and raw experiment folders (kept local, too large for git)
Dataset/
exdark_yolo_dark/
Results_try/
Results_final /
Results_final/

# Model checkpoints and exported inference models
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.tflite

# Cho phép thư mục Results và các file mô hình, biểu đồ đi kèm
!Results/
!Results/**
!Results/weights/*.pt
!Results/weights/*.pth

# Allow bundled lightweight weights and sample images for Demo / Doc
!Demo/weights/
!Demo/weights/*.pt
!Demo/weights/*.pth
!Demo/static/sample_images/
!Demo/static/sample_images/*
!Doc/weights/
!Doc/weights/*.pt
!Doc/weights/*.pth
!Doc/samples/
!Doc/samples/*

# Generated experiment outputs
runs/
yolo_runs/
wandb/
mlruns/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
nul

# IDE and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
